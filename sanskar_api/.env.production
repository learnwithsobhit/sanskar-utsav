# ═══════════════════════════════════════════
# Sanskar Utsav API — Production Environment
# ═══════════════════════════════════════════
# Copy this to .env and fill in your values.
# NEVER commit .env to git!

# ─── Database (Railway provides this) ───
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Redis (Railway provides this) ───
REDIS_URL=redis://default:password@host:6379

# ─── NATS (optional — leave empty to skip) ───
NATS_URL=

# ─── OTLP / Jaeger (optional — leave empty for logs-only) ───
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sanskar-api

# ─── Server ───
PORT=8080
RUST_LOG=sanskar_api=info,actix_web=info

# ─── S3 (AWS) ───
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=sanskar-utsav-media
# Smoother video (recommended in production): set to your public bucket URL or CloudFront origin
# (e.g. https://d1234567890.cloudfront.net or https://my-bucket.s3.ap-south-1.amazonaws.com).
# Then media file_url points here and clients load video directly (Range requests, no API proxy).
# Bucket CORS must allow GET/HEAD from your Firebase web origin and expose Accept-Ranges / Content-Range.
S3_PUBLIC_URL=
# Used only when S3_PUBLIC_URL is empty — builds /api/media/serve/... URLs (extra hop; worse for large video).
API_PUBLIC_URL=https://your-api.railway.app

# ─── Admin Phone Numbers ───
ADMIN_PHONES=+919999999999
